            "w0dTl": {
              "content": "形や地の差でも区切った部品"
            },
            "cFPUR": {
              "content": "border だけで区切った部品"
            },
            "LX4u5": {
              "content": "UI 部品を見分けるのに要る境界と図形は、隣の色と 3:1 以上にする。`border` は `background` と 3:1 に届かないため、UI 部品を見分ける手がかりを `border` だけにしない"
            }
          }
        },
