{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint .",
    "preview": "vinext build && wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --skip-build --config dist/server/wrangler.json --name synsk-me --experimental-warm-cdn-cache --warm-cdn-target https://synsk.me && npm run verify:deploy",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "upload": "wrangler versions upload --config dist/server/wrangler.json",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "postcss": "^8",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "wrangler": "^4.128.0"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7"
  },
  "type": "module"
}
