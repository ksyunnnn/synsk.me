# 手元で使う値の雛形。`.env.local` に写して値を入れる（git が追跡しない）。
# Worker の secret は `.dev.vars.example` が持つ。

# Cloudflare の API トークン。Cloudflare 上の名前は `synsk.me local <環境>`。
# 権限は Access のアプリとポリシー・組織とID プロバイダーとグループ・サービストークン、
# D1 が編集、ゾーンの Cache Purge が編集。
CLOUDFLARE_API_TOKEN_PRODUCTION=
CLOUDFLARE_API_TOKEN_STAGING=

# Workers Builds の設定（対象ブランチ、ビルドとデプロイのコマンド）を読み書きする。
# Cloudflare 上の名前は `synsk.me builds`。user トークンでしか通らない。
# 権限は Workers Builds 構成が編集、Workers スクリプトが読み取り。
CLOUDFLARE_BUILDS_API_TOKEN=

# Access の service token。Cloudflare 上の名前は `synsk.me verify <環境>`。
# `npm run verify:deploy` が、Access で守られた配信を検査するときに使う。
CLOUDFLARE_ACCESS_CLIENT_ID_PRODUCTION=
CLOUDFLARE_ACCESS_CLIENT_SECRET_PRODUCTION=
CLOUDFLARE_ACCESS_CLIENT_ID_STAGING=
CLOUDFLARE_ACCESS_CLIENT_SECRET_STAGING=

# PageSpeed Insights API と CrUX API。表示速度を測るときに使う。
PAGESPEED_API_KEY=
