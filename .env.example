# 外部 API の取得を広げる値。未設定でも /lab/timeline は動作する。
# 実際の値は .env.local に置く（.env はリポジトリに含まれる）。

# connpass v2 API。設定すると参加イベントを取得する。
# 申請: https://connpass.com/about/api/v2/
CONNPASS_API_KEY=

# Qiita のレート制限を 60 req/h から 1000 req/h に上げる。
# 発行: https://qiita.com/settings/applications
QIITA_ACCESS_TOKEN=

# GitHub のレート制限を 60 req/h から 5000 req/h に上げる。
# 発行: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=
