{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "synsk-me",
  // vinext の fetch ハンドラを呼ぶ入口。/dash の外への大きい POST を vinext に渡す前に拒み、
  // プレビュー配信の応答だけを書き換える
  "main": "./worker/index.ts",
  // synsk.me だけを入口にする。workers.dev で同じ内容が配信されると
  // 検索エンジンから見て重複する
  "workers_dev": false,
  // ブランチごとのプレビュー URL は出す。既定では workers_dev に従って
  // 無効になるため、明示する
  "preview_urls": true,
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "synsk-me",
      "database_id": "23a6b53c-fb77-46ef-b299-a4696de72226",
    },
  ],
  // 画像の保管先（ADR-0012）。機能をまたいで共有し、
  // 読み書きは src/shared/server/media-storage.ts に閉じ込める。
  // IMAGES は Cloudflare Images が使うため別の名前にする
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "synsk-me-images",
    },
  ],
  "images": {
    // next/image の最適化。vite.config.ts の imagesOptimizer() が実行時に使う
    "binding": "IMAGES",
  },
  // vinext の CDN キャッシュ（vite.config.ts の cdnAdapter）が使う Workers Cache
  "cache": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // 定期実行（worker/scheduled.ts、specs/004-external-activity/research.md の R8・R9）。
  // UTC で 1 日 7 回、間を 3 時間と 4 時間の交互にして起動し、起動ごとに外部の取得元を 1 つ
  // 取り直す。0 時の回は消し損ねた画像も突き合わせる。式は 1 本にする（アカウントで 5 本まで）
  // https://developers.cloudflare.com/workers/configuration/cron-triggers/
  "triggers": { "crons": ["0 0,3,7,10,14,17,21 * * *"] },
  // Workers Logs。定期実行の 1 回ごとの CPU 時間（$workers.cpuTimeMs）を本番で読むため
  // https://developers.cloudflare.com/workers/observability/logs/workers-logs/
  "observability": { "enabled": true },
  // ブランチごとの Preview の設定。トップレベルの値は引き継がれないため、
  // バインディングを並べ直す。データはプレビュー用の資源に分け、本番に触れない。
  // D1 のマイグレーションは wrangler.preview-migrations.jsonc から当てる
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "synsk-me-preview",
        "database_id": "18fc9308-c75a-43b6-ace2-29acc20615e8",
      },
    ],
    "r2_buckets": [
      {
        "binding": "MEDIA",
        "bucket_name": "synsk-me-images-preview",
      },
    ],
    "images": { "binding": "IMAGES" },
    "version_metadata": { "binding": "CF_VERSION_METADATA" },
  },
}
