# `wrangler dev` が読む設定値の雛形。`.dev.vars` に写して値を入れる。
# `.dev.vars` は git が追跡しない。本番とプレビューの値は Worker の secret に置く。
#
# `/dash` の画面と書き込みの操作は、Cloudflare Access が付ける
# `Cf-Access-Jwt-Assertion` の JWT を検証する（docs/decisions/0036-verify-access-jwt-in-app.md）。
# 3 つのどれかが欠けると、オーナーであることを確かめられないとして拒む。

# Access の team domain。公開鍵は `<ACCESS_ISSUER>/cdn-cgi/access/certs` から取る
ACCESS_ISSUER=https://<team-name>.cloudflareaccess.com
# Access のアプリケーションの Application Audience (AUD) Tag。本番の `/dash` とプレビュー全体の
# 2つのアプリケーションの AUD タグをカンマで区切って並べる。どれかに一致すれば通す
ACCESS_AUD=<application-audience-tag>
# オーナーとして認めるメールアドレス
ACCESS_OWNER_EMAIL=<owner@example.com>

# 職務経歴書のプロフィールに出すメールアドレス（specs/002-resume/research.md の R10）。
# 空か無ければ、職務経歴書にメールアドレスを出さない
RESUME_EMAIL=<resume@example.com>

# 外部の activity の取得に使う認証情報（specs/004-external-activity/research.md の R3）。
# GitHub と Qiita は無くても取れる（1 時間に 60 回まで）。connpass は無ければ取らない
GITHUB_TOKEN=<github-token>
QIITA_ACCESS_TOKEN=<qiita-token>
CONNPASS_API_KEY=<connpass-api-key>
